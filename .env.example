# Token dari @BotFather
BOT_TOKEN=

# Chat ID yang boleh memakai bot (pisahkan koma). Kosong = semua orang boleh.
# Belum tahu ID-nya? Biarkan kosong sebentar, kirim /start ke bot, lalu isi.
ALLOWED_CHAT_IDS=

# Jumlah unduhan paralel (Jetson: 1 sudah cukup, kompresi berat di CPU)
MAX_JOBS=1

# Opsional, untuk nanti: file cookies.txt (format Netscape) dari akun cadangan.
# Kosong = tanpa login.
IG_COOKIES=
