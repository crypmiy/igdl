# Token dari @BotFather
BOT_TOKEN=

# Chat ID yang boleh memakai bot (pisahkan koma). Kosong = semua orang boleh.
# Belum tahu ID-nya? Biarkan kosong sebentar, kirim /start ke bot, lalu isi.
ALLOWED_CHAT_IDS=

# Jumlah unduhan paralel (Jetson: 1 sudah cukup, kompresi berat di CPU)
MAX_JOBS=1

# Jumlah post terbaru yang dikirim bot untuk "@akun" (bisa diubah per pesan: "@akun 5")
PROFILE_N=12

# Opsional: file cookies.txt (format Netscape) dari AKUN CADANGAN.
# Dipakai untuk "igdl @akun --all" (riwayat lengkap). Kosong = tanpa login.
IG_COOKIES=
